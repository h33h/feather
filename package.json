{
  "name": "isign-service",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node backend/scripts/local-server.mjs",
    "build": "next build web --webpack",
    "start": "next start web --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "lint": "eslint .",
    "design:tokens": "tsx backend/scripts/design-tokens.ts",
    "design:check": "tsx backend/scripts/design-tokens.ts --check",
    "brand:assets": "node backend/scripts/brand-assets.mjs",
    "test:browser": "PLAYWRIGHT_CHANNEL=chrome playwright test",
    "personal:admin": "tsx backend/scripts/personal-admin.ts",
    "setup:catalog": "node backend/scripts/install-isignkit.mjs",
    "prepare": "node backend/scripts/setup-tools.mjs",
    "format": "pnpm format:web && pnpm format:python",
    "format:check": "pnpm format:check:web && pnpm format:check:python",
    "format:web": "prettier --write . --ignore-unknown --ignore-path .prettierignore --ignore-path .gitignore --ignore-path backend/.gitignore",
    "format:check:web": "prettier --check . --ignore-unknown --ignore-path .prettierignore --ignore-path .gitignore --ignore-path backend/.gitignore",
    "format:python": "node backend/scripts/ruff.mjs format backend",
    "format:check:python": "node backend/scripts/ruff.mjs format --check backend",
    "lint:python": "node backend/scripts/ruff.mjs check backend",
    "lint:fix": "eslint . --fix",
    "check:hooks": "node --test backend/scripts/hooks.test.mjs",
    "test:deploy": "node --test backend/scripts/deploy.test.mjs",
    "setup:runner": "node backend/scripts/setup-runner.mjs",
    "package:client": "node backend/scripts/package-client.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "ipaddr.js": "2.5.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.21.0",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-sql": "0.20.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@electric-sql/pglite": "0.5.8"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.20.0"
  }
}
