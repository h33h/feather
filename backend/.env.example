# Personal runtime only. Replace paths and test placeholders before starting.
ISIGN_RUNTIME=personal
ISIGN_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://isign:REPLACE@127.0.0.1:5432/isign
ISIGN_PERSONAL_DATABASE_TRANSPORT=loopback
ISIGN_PERSONAL_DATA=/absolute/path/isign/objects
ISIGN_PERSONAL_KEY_FILE=/absolute/path/isign/keys/vault_key
ISIGN_RUNNER_ORIGIN=https://runner.example.invalid:8443
ISIGN_RUNNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ISIGN_RUNNER_AUDIENCE=isign-personal
ISIGN_RUNNER_PROOF_KEY=REPLACE_WITH_64_HEX_DIGITS
# HTTPS is required for installation links. Loopback HTTP is development only.

# Official iSign Client template for browser installation (absolute path + pinned SHA256).
# ISIGN_CLIENT_IPA_PATH=/run/isign/client/ISignClient.ipa
# ISIGN_CLIENT_IPA_SHA256=REPLACE_WITH_64_HEX_DIGITS
# ISIGN_CLIENT_VERSION=2.9.0
