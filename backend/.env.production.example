ISIGN_RUNTIME=personal
ISIGN_ORIGIN=https://isign.example.invalid
# Apply migrate:feather and deploy the matching guest verifier before enabling.
ISIGN_FEATHER_ENABLED=false
ISIGN_FEATHER_OPENSSL=/usr/bin/openssl
ISIGN_PERSONAL_DATABASE_TRANSPORT=private-bridge
# Keep private credentials in a separate mode-0600 server.env.
DATABASE_URL=postgresql://isign:REPLACE@postgres/isign
ISIGN_RUNNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ISIGN_RUNNER_PROOF_KEY=REPLACE_WITH_64_HEX_DIGITS
ISIGN_PERSONAL_DATA=/data/isign
ISIGN_PERSONAL_KEY_FILE=/run/secrets/vault_key
ISIGN_RUNNER_ORIGIN=https://runner.internal:8443
ISIGN_RUNNER_AUDIENCE=isign-personal
ISIGN_RUNNER_PROTOCOL=isign-native-v1
ISIGN_PROVISIONING_PROTOCOL=isign-provisioning-v1
ISIGN_MATERIAL_PROTOCOL=isign-sealed-materials-v1
# Device enrollment uses an Apple ProfileService callback verified with OpenSSL.
# Optional private server.env overrides: ISIGN_COLLECTION_CA_PEM and its SHA256 pin.
# Trust file contains public CA only. No disabling TLS verification.
NODE_EXTRA_CA_CERTS=/run/isign/runner-ca.pem

# Official iSign Client template for browser installation (absolute path + pinned SHA256).
# ISIGN_CLIENT_IPA_PATH=/run/isign/client/ISignClient.ipa
# ISIGN_CLIENT_IPA_SHA256=REPLACE_WITH_64_HEX_DIGITS
# ISIGN_CLIENT_VERSION=2.9.0
